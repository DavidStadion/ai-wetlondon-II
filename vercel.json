{
  "devCommand": "echo 'No dev server needed'",
  "_comment_rewrites": "Every real route is prerendered to its own file and served directly, so the old catch-all rewrite only ever caught URLs that do not exist and handed them the homepage with HTTP 200. Unmatched paths now fall through to dist/404.html with a real 404. Only these two routes have no prerendered file: /saved is per-visitor localStorage and /admin is not for crawlers.",
  "rewrites": [
    { "source": "/saved", "destination": "/" },
    { "source": "/admin", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/rain-alert",
      "schedule": "50 6 * * *"
    }
  ]
}
